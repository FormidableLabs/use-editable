{
  "name": "use-editable",
  "description": "A small React hook to turn elements into fully renderable & editable content surfaces, like code editors, using contenteditable (and magic)",
  "version": "2.3.3",
  "type": "commonjs",
  "main": "dist/use-editable.js",
  "module": "dist/use-editable.es.js",
  "types": "dist/use-editable.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "keywords": [
    "contenteditable",
    "text editing",
    "react",
    "hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormidableLabs/use-editable.git"
  },
  "bugs": {
    "url": "https://github.com/FormidableLabs/use-editable/issues"
  },
  "scripts": {
    "check": "npm run check:format && npm run check:types",
    "build": "tsdown",
    "check:format": "prettier --check .",
    "check:types": "tsc",
    "format": "prettier --write .",
    "prepack": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "es5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
